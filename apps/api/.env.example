# Copia este archivo como .env y cambia la clave (cambia_esta_clave) por la de tu PostgreSQL local.
# El archivo .env es solo tuyo: no se sube al repositorio.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# De la URL se usan solo usuario, clave, host, puerto y nombre de la base; los parámetros después de ? se ignoran.
DATABASE_URL=postgres://polleria:cambia_esta_clave@localhost:5432/polleria_dev
# Base solo para pruebas automáticas: su nombre debe terminar en _test.
DATABASE_URL_TEST=postgres://polleria:cambia_esta_clave@localhost:5432/polleria_test
# Impresión de comandas. file guarda cada papel como un archivo .txt en la carpeta de abajo, para probar sin impresora.
# escpos (impresora térmica de 80 mm) llegará más adelante: por ahora no se acepta.
PRINTER_DRIVER=file
# Carpeta de los archivos del driver file. Una ruta relativa se toma desde la raíz del proyecto; la carpeta se crea sola.
PRINTER_FILE_DIR=tmp/comandas
