# Copia este archivo como .env si necesitas cambiar algo. Si no, la web usa estos mismos valores.

# Dirección interna de la API. La web reenvía /api a esta dirección.
API_INTERNAL_URL=http://127.0.0.1:4000

# IP o nombres de la PC permitidos en modo desarrollo, separados por comas.
# Ejemplo para probar desde un celular: 192.168.1.10
WEB_ALLOWED_DEV_ORIGINS=
